{
  // The first deploy puts this file up as `la-table` (`wrangler deploy -c probes/placeholder/wrangler.jsonc`) before Access
  // protects that Worker; the app replaces it once scripts/deploy-ci.ts has seen Access in front. Never bound to D1.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "la-table",
  // the app's account, as in wrangler.jsonc: wrangler reads it before CLOUDFLARE_ACCOUNT_ID, a .env or its account cache
  "account_id": "44513f9fd94c38330fc5ca98603adf15",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // the app's shape: static assets first, the Worker first on /api/*, so Access hands it what it will hand the app
  "assets": { "directory": "./assets", "run_worker_first": ["/api/*"] }
}
